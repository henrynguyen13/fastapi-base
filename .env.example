# App
APP_NAME="FastAPI Base"
ENVIRONMENT=local            # local | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1

# Server
HOST=0.0.0.0
PORT=8000

# CORS - comma separated
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Database (async driver!)
# Postgres:  postgresql+asyncpg://user:pass@localhost:5432/appdb
# SQLite:    sqlite+aiosqlite:///./app.db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/appdb
DB_ECHO=false

# Security
SECRET_KEY=change-me-please-generate-with-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
